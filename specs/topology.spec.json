{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-codebox",
  "applicationCode": "codebox",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production",
        "demo"
      ]
    },
    "connectivityPlane": {
      "allowed": [
        "application",
        "platform"
      ]
    },
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.demo": "etc/topology/standalone.demo.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.demo": "etc/topology/cloud.demo.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_CODEBOX_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_CODEBOX_ENVIRONMENT",
    "profileId": "SDKWORK_CODEBOX_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_CODEBOX_DEPLOYMENT_PROFILE",
    "standaloneGatewayBind": "SDKWORK_CODEBOX_APPLICATION_PUBLIC_INGRESS_BIND",
    "apiGatewayBaseUrl": "SDKWORK_CODEBOX_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_CODEBOX_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_CODEBOX_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_CODEBOX_PLATFORM_API_GATEWAY_HTTP_URL"
    },
    "desktop.client": {
      "connectivityPlane": "application",
      "protocols": [
        "native"
      ],
      "optional": true
    }
  },
  "components": {
    "standaloneGateway": {
      "crate": "sdkwork-api-codebox-standalone-gateway",
      "binary": "sdkwork-api-codebox-standalone-gateway"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "standalone-gateway",
            "role": "api-standalone-gateway",
            "command": "cargo",
            "args": [
              "run",
              "--manifest-path",
              "crates/sdkwork-api-codebox-standalone-gateway/Cargo.toml"
            ],
            "bindEnv": "SDKWORK_CODEBOX_APPLICATION_PUBLIC_INGRESS_BIND",
            "required": true
          },
          {
            "id": "desktop-client",
            "script": "_sdkwork:client:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": []
      },
      "cloud.development": {
        "processes": [
          {
            "id": "desktop-client",
            "script": "_sdkwork:client:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.production": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "cloud.production": {
        "processes": [],
        "healthSurfaces": []
      },
      "standalone.test": {
        "processes": [
          {
            "id": "standalone-gateway",
            "role": "api-standalone-gateway",
            "command": "cargo",
            "args": [
              "run",
              "--manifest-path",
              "crates/sdkwork-api-codebox-standalone-gateway/Cargo.toml"
            ],
            "bindEnv": "SDKWORK_CODEBOX_APPLICATION_PUBLIC_INGRESS_BIND",
            "required": true
          },
          {
            "id": "desktop-client",
            "script": "_sdkwork:client:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": []
      },
      "standalone.staging": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "cloud.test": {
        "processes": [
          {
            "id": "desktop-client",
            "script": "_sdkwork:client:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.staging": {
        "processes": [],
        "healthSurfaces": []
      },
      "standalone.demo": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "cloud.demo": {
        "processes": [],
        "healthSurfaces": []
      }
    }
  },
  "packaging": {
    "targets": [],
    "cloudConfigFiles": []
  },
